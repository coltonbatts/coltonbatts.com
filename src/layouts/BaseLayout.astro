---
import { navItems, site } from '../config';
import RivePlayer from '../components/interactive/RivePlayer.astro';
import { resolveRiveRecipe } from '../content/rive-recipes';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const fullTitle = title === site.title ? title : `${title} | ${site.title}`;
const currentPath = Astro.url.pathname;
const routeRecipe = resolveRiveRecipe('routePunctuation');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-custom.png" />
		<link rel="apple-touch-icon" href="/favicon-custom.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Inter-Black.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexMono-Bold.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/card.png', Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/card.png', Astro.url)} />

		<title>{fullTitle}</title>
	</head>

	<body class="antialiased min-h-screen flex flex-col">

		<header class="site-header">
			<nav class="site-nav" aria-label="Primary navigation">
				<a href="/" class="site-logo" aria-label="Colton Batts home">
					<span>CB</span>
				</a>

				<p class="site-nav__date" aria-label="Studio date">
					<span>Independent Studio</span>
					<span>{new Date().toISOString().split('T')[0].replace(/-/g, '.')}</span>
				</p>

				<button
					id="mobile-menu-toggle"
					class="site-menu-toggle"
					aria-label="Toggle Menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<span></span>
					<span></span>
				</button>

				<div id="mobile-menu" class="site-menu" hidden>
					<ul>
						{navItems.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))) ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<div id="motion-intro-curtain" aria-hidden="true">
			<span></span>
			<span></span>
		</div>
		<div id="route-kinetic-punctuation" aria-hidden="true"></div>
		<RivePlayer
			id="route-punctuation-player"
			class="route-punctuation-rive"
			src="/rive/ui/button.riv"
			recipe={routeRecipe}
			respectReducedMotion={false}
		>
			<div slot="fallback" class="route-punctuation-fallback" aria-hidden="true"></div>
		</RivePlayer>

		<footer class="site-footer">
			<div class="site-footer__grid">
				<p class="site-footer__mark">CB</p>
				<div>
					<p class="studio-kicker">Studio</p>
					<p>Colton Batts<br />Graphic Design / Motion / Production Systems</p>
				</div>
				<div>
					<p class="studio-kicker">Navigate</p>
					<ul>
						{navItems.map((item) => (
							<li><a href={item.href}>{item.label}</a></li>
						))}
					</ul>
				</div>
				<div>
					<p class="studio-kicker">Contact</p>
					<a href="mailto:colton.batts@gmail.com">colton.batts@gmail.com</a>
					<p>&copy; {new Date().getFullYear()}</p>
				</div>
			</div>
		</footer>
		<!-- Mobile menu — standalone, no dependencies, runs immediately -->
		<script is:inline>
			(function () {
				var toggle = document.getElementById('mobile-menu-toggle');
				var menu = document.getElementById('mobile-menu');
				if (!toggle || !menu) return;

				toggle.addEventListener('click', function () {
					var isOpen = !menu.hasAttribute('hidden');
					if (isOpen) {
						menu.setAttribute('hidden', '');
					} else {
						menu.removeAttribute('hidden');
					}
					toggle.classList.toggle('is-open');
					toggle.setAttribute('aria-expanded', String(!isOpen));
				});

				menu.addEventListener('click', function (e) {
					if (e.target.tagName === 'A') {
						menu.setAttribute('hidden', '');
						toggle.classList.remove('is-open');
						toggle.setAttribute('aria-expanded', 'false');
					}
				});
			})();
		</script>

		<!-- Animations — module bundle, loaded async -->
		<script type="module">
			import { initLotties, cleanupLotties } from '../animations/lottie';
			import { initReveal, cleanupReveal } from '../animations/reveal';
			import { initMotionOS, notifyRouteTransitionEnd, notifyRouteTransitionStart } from '../motion/orchestrator';

			const initMotion = () => {
				initMotionOS();
				initLotties();
				initReveal();
				notifyRouteTransitionEnd();
			};

			const cleanupMotion = () => {
				notifyRouteTransitionStart();
				cleanupLotties();
				cleanupReveal();
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initMotion, { once: true });
			} else {
				initMotion();
			}

			document.addEventListener('astro:page-load', initMotion);
			document.addEventListener('astro:before-swap', cleanupMotion);
			document.addEventListener('astro:before-preparation', cleanupMotion);
		</script>
	</body>
</html>
