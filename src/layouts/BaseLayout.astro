---
import { ClientRouter } from 'astro:transitions';
import { navItems, site } from '../config';
import '../styles/global.css';
import '../styles/editorial.css';

interface Props {
	title?: string;
	description?: string;
	/** Homepage book-cover mode — chrome stays quiet. */
	cover?: boolean;
}

const { title = site.title, description = site.description, cover = false } = Astro.props;
const fullTitle = title === site.title ? title : `${title} | ${site.title}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-motion-intensity="editorial" class:list={[{ 'is-cover': cover }]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-custom.png" />
		<link rel="apple-touch-icon" href="/favicon-custom.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/InstrumentSerif-Italic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/InstrumentSans.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/UnifrakturMaguntia-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexMono-Bold.woff2" as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/card.jpg', Astro.url)} />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/card.jpg', Astro.url)} />

		<title>{fullTitle}</title>
		<ClientRouter />
	</head>

	<body class:list={['antialiased', 'min-h-screen', 'flex', 'flex-col', { 'body--cover': cover }]}>
		<a class="skip-link" href="#main-content">Skip to content</a>

		{!cover && (
			<header class="site-header">
				<nav class="site-nav" aria-label="Primary navigation">
					<a href="/" class="site-logo" aria-label="Colton Batts — home">
						<span class="site-logo__name">Colton Batts</span>
						<span class="site-logo__role">Film & Motion</span>
					</a>

					<button
						id="mobile-menu-toggle"
						class="site-menu-toggle"
						aria-label="Toggle Menu"
						aria-expanded="false"
						aria-controls="mobile-menu"
					>
						<span></span>
						<span></span>
					</button>

					<div id="mobile-menu" class="site-menu">
						<ul>
							{navItems.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))) ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				</nav>
			</header>
		)}

		<main id="main-content" class="flex-1">
			<slot />
		</main>

		{!cover && (
			<footer class="site-footer">
				<div class="site-footer__grid">
					<p class="site-footer__mark">Colton Batts</p>
					<a class="site-footer__email" href="mailto:colton.batts@gmail.com">colton.batts@gmail.com</a>
					<p class="site-footer__copy">&copy; {new Date().getFullYear()}</p>
				</div>
			</footer>
		)}

		<script is:inline>
			document.addEventListener('click', function (e) {
				var toggle = document.getElementById('mobile-menu-toggle');
				var menu = document.getElementById('mobile-menu');
				if (!toggle || !menu) return;

				if (toggle.contains(e.target)) {
					var isOpen = toggle.getAttribute('aria-expanded') === 'true';
					toggle.classList.toggle('is-open', !isOpen);
					menu.classList.toggle('is-open', !isOpen);
					toggle.setAttribute('aria-expanded', String(!isOpen));
				} else if (menu.contains(e.target) && e.target.tagName === 'A') {
					menu.classList.remove('is-open');
					toggle.classList.remove('is-open');
					toggle.setAttribute('aria-expanded', 'false');
				}
			});
		</script>

		<script>
			function initReveals() {
				const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
				if (reduced) {
					reveals.forEach((el) => el.classList.add('reveal', 'reveal--visible', 'reveal--instant'));
				} else if (reveals.length) {
					const revealObserver = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('reveal--visible');
							revealObserver.unobserve(entry.target);
						});
					}, { threshold: 0.18, rootMargin: '0px 0px -12% 0px' });
					reveals.forEach((el, index) => {
						el.classList.add('reveal');
						el.style.transitionDelay = `${Math.min(index % 4, 3) * 70}ms`;
						revealObserver.observe(el);
					});
				}
			}

			document.addEventListener('astro:page-load', initReveals);
		</script>
	</body>
</html>
