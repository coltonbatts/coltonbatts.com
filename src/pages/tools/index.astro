---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const tools = await getCollection('tools');
tools.sort((a, b) => {
	const statusOrder = { active: 0, beta: 1, archived: 2 };
	return statusOrder[a.data.status] - statusOrder[b.data.status];
});
---

<BaseLayout title="Tools" description="Offline-first tools you actually own.">
	<section class="page-hero page-hero--olive" data-motion-chapter>
		<p class="studio-kicker">Systems proof · {String(tools.length).padStart(2, '0')}</p>
		<h1>Useful<br /><em>objects.</em></h1>
		<p>Small tools for makers. Local-first, intentionally designed — character evidence that I build systems, not just deliverables.</p>
	</section>

	<section class="tool-archive">
		{tools.map((tool, index) => {
				const toolHref = tool.data.externalUrl || `/tools/${tool.id}`;
				return (
				<a
					href={toolHref}
					{...(tool.data.externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					class="tool-entry"
				>
					<div class="tool-entry__meta">
						<span>{String(index + 1).padStart(2, '0')}</span>
						<span>{tool.data.status} / {tool.data.platform}</span>
					</div>
					{tool.data.heroImage ? (
						<Image
							src={tool.data.heroImage}
							alt={`${tool.data.name} interface`}
							widths={[720, 1200, 1600]}
							sizes="(max-width: 768px) 100vw, 70vw"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<div class="tool-entry__plate">{tool.data.name}</div>
					)}
					<div class="tool-entry__info">
						<h2>{tool.data.name}</h2>
						<p>{tool.data.oneLiner}</p>
						<span>View project ↗</span>
					</div>
				</a>
				);})}
	</section>
</BaseLayout>
