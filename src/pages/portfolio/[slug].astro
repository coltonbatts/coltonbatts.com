---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const paintings = await getCollection('paintings');
	paintings.sort((a, b) => a.data.order - b.data.order);

	return paintings.map((painting, index) => ({
		params: { slug: painting.id },
		props: {
			painting,
			prev: index > 0 ? paintings[index - 1] : null,
			next: index < paintings.length - 1 ? paintings[index + 1] : null,
		},
	}));
}

const { painting, prev, next } = Astro.props;
const { Content } = await render(painting);
const { title, medium, dimensions, year, series, vimeoId } = painting.data;
---

<BaseLayout title={title} description={`${title} — ${medium}, ${year}. Colton Batts.`}>
	<article class="case-study" data-motion-chapter>
		<header class="case-study__header">
			<a href="/portfolio" class="case-study__back">&larr; All work</a>
			{series && <p class="studio-kicker">{series}</p>}
			<h1>{title}</h1>
			<dl class="case-study__meta">
				<div>
					<dt>Role</dt>
					<dd>{medium}</dd>
				</div>
				<div>
					<dt>Scope</dt>
					<dd>{dimensions}</dd>
				</div>
				<div>
					<dt>Year</dt>
					<dd>{year}</dd>
				</div>
			</dl>
		</header>

		<figure class="case-study__media project-edition__media--client">
			{vimeoId ? (
				<div class="case-study__video">
					<iframe
						src={`https://player.vimeo.com/video/${vimeoId}?background=1&autoplay=1&loop=1&muted=1&dnt=1`}
						allow="autoplay; fullscreen"
						loading="eager"
						title={title}
					></iframe>
				</div>
			) : (
				<div class="case-study__plate">{title}</div>
			)}
		</figure>

		<div class="case-study__body prose">
			<Content />
		</div>

		<nav class="case-study__nav" aria-label="Adjacent projects">
			{prev ? (
				<a href={`/portfolio/${prev.id}`}>&larr; {prev.data.title}</a>
			) : (
				<span></span>
			)}
			{next ? (
				<a href={`/portfolio/${next.id}`}>{next.data.title} &rarr;</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
</BaseLayout>
