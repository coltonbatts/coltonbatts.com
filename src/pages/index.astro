---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import '../styles/home.css';

import ReelStage from '../components/ReelStage.astro';
import trailerPoster from '../assets/home/vcr-trailer-poster.jpg';

const email = 'colton.batts@gmail.com';
const vcrTrailerId = '1166117135';
---

<BaseLayout
	title="Video, Motion & Software"
	description="Colton Batts is a video editor and motion designer who builds software. Open to full-time roles and selected projects."
>
	<section class="hm-hero">
		<div class="hm-hero__copy">
			<p class="hm-kicker">Fort Worth, Texas</p>
			<h1>I make the work, and I <em>build the tools</em> that make it.</h1>
			<div class="hm-hero__actions">
				<a class="hm-button hm-button--primary" href={`mailto:${email}`}>Email me <span aria-hidden="true">↗</span></a>
				<a class="hm-link" href="#reel">Watch the reel ↓</a>
			</div>
		</div>
	</section>

	<ReelStage />

	<section class="hm-proof" aria-label="Clients">
		<p class="hm-kicker">Shipped for</p>
		<ul>
			<li>Google</li>
			<li>Nuuly</li>
			<li>Under Armour</li>
			<li>Kate Spade</li>
		</ul>
	</section>

	<section id="built" class="hm-flagship">
		<div class="hm-flagship__text">
			<p class="hm-kicker">Open source · Motion tooling</p>
			<h2>VCR</h2>
			<p class="hm-flagship__line">Motion graphics from the terminal.</p>
			<ul class="hm-facts">
				<li>Rust · Metal GPU</li>
				<li>YAML in · ProRes 4444 out</li>
			</ul>
			<div class="hm-flagship__links">
				<a class="hm-link" href="https://github.com/coltonbatts/VCR" rel="noopener">Source on GitHub ↗</a>
				<a class="hm-link" href="https://vimeo.com/1166117135" rel="noopener">Trailer on Vimeo ↗</a>
			</div>
		</div>

		<div class="hm-flagship__media">
			<div class="hm-trailer" data-vimeo-facade={vcrTrailerId}>
				<Image
					src={trailerPoster}
					alt="Still from the VCR trailer"
					widths={[360, 720]}
					sizes="(max-width: 900px) 90vw, 22rem"
					loading="lazy"
					decoding="async"
				/>
				<button type="button" aria-label="Play the VCR trailer"><span>Play trailer · 1:00</span></button>
			</div>
		</div>
	</section>

	<section class="hm-flagship hm-flagship--reverse">
		<div class="hm-flagship__text">
			<p class="hm-kicker">Live · Web</p>
			<h2>ColorWizard</h2>
			<p class="hm-flagship__line">A color in, a paint mix and a thread match out.</p>
			<div class="hm-flagship__links">
				<a class="hm-button hm-button--primary" href="https://colorwizard.app/" rel="noopener">Open ColorWizard ↗</a>
				<a class="hm-link" href="https://github.com/coltonbatts/colorwizard" rel="noopener">Source on GitHub ↗</a>
			</div>
		</div>

		<div class="hm-flagship__media">
			<ol class="hm-flow">
				<li><div><strong>Open</strong><span>Image</span></div></li>
				<li><div><strong>Sample</strong><span>Color</span></div></li>
				<li><div><strong>Recipe</strong><span>Paint + thread</span></div></li>
				<li><div><strong>Save</strong><span>Palette</span></div></li>
			</ol>
		</div>
	</section>

	<section class="hm-also">
		<header>
			<h2>Also shipped</h2>
			<p class="hm-kicker">Real tools, real users</p>
		</header>
		<ul class="hm-cards">
			<li class="hm-card">
				<a href="https://coffee.capturethis.com" rel="noopener">
					<p class="hm-kicker">Operations</p>
					<h3>Capture This Coffee</h3>
					<p>Coffee orders for crews.</p>
					<span class="hm-card__go">Visit ↗</span>
				</a>
			</li>
			<li class="hm-card">
				<a href="/tools/magpie">
					<p class="hm-kicker">Craft</p>
					<h3>MagpieApp</h3>
					<p>Photo to embroidery pattern.</p>
					<span class="hm-card__go">Read more →</span>
				</a>
			</li>
			<li class="hm-card">
				<a href="/portfolio">
					<p class="hm-kicker">Commercial</p>
					<h3>Client work</h3>
					<p>Google, Nuuly, Kate Spade.</p>
					<span class="hm-card__go">See the work →</span>
				</a>
			</li>
		</ul>
	</section>

	<section class="hm-experience">
		<header>
			<h2>Experience</h2>
		</header>
		<ol class="hm-experience__list">
			<li>
				<time>2021 – Present</time>
				<div>
					<h3>Lead Video Editor, Capture This</h3>
					<p>Lead editor on national campaigns for Google, Under Armour, Kate Spade and Nuuly. High-volume deliverables across aspect ratios, rough cuts turned in 24 hours.</p>
				</div>
			</li>
			<li>
				<time>2015 – 2021</time>
				<div>
					<h3>Multimedia Designer &amp; Video Lead, Freedom Powersports</h3>
					<p>Design and video production for retail and events across multiple brands.</p>
				</div>
			</li>
		</ol>
		<p class="hm-experience__more"><a class="hm-link" href="/resume">Full resume →</a></p>
	</section>

	<section class="hm-close" id="contact">
		<p class="hm-kicker">Open to work</p>
		<h2>Let’s <em>work</em>.</h2>
		<div class="hm-close__actions">
			<a class="hm-button hm-button--primary" href={`mailto:${email}`}>{email} <span aria-hidden="true">↗</span></a>
			<a class="hm-link" href="/resume">Resume</a>
		</div>
	</section>
</BaseLayout>

<script>
	/* The trailer is a poster until clicked, so no third-party player loads with the page. */
	document.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest('.hm-trailer button');
		if (!button) return;
		const frame = button.closest<HTMLElement>('.hm-trailer');
		const id = frame?.dataset.vimeoFacade;
		if (!frame || !id) return;
		const iframe = document.createElement('iframe');
		iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`;
		iframe.allow = 'autoplay; fullscreen; picture-in-picture';
		iframe.title = 'VCR trailer';
		frame.replaceChildren(iframe);
	});
</script>
