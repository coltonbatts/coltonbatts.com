---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';

import heroMovement from '../assets/hero/movement-study.png';

import ArtPlate from '../components/ArtPlate.astro';
import WorkMedia from '../components/WorkMedia.astro';
import { art } from '../data/art';

const projects = (await getCollection('paintings'))
	.filter((project) => !project.data.hidden)
	.sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools')).slice(0, 2);

/** The homepage shows a teaser; the full archive lives at /art. */
const featuredArt = art.slice(0, 6);

/**
 * The hero is the lead frame of the archive, not a separate asset, so the
 * opening image and the archive can't drift apart. Portrait source, so it
 * gets a full-height column — the crop is set on .monograph-hero__image img.
 */
const heroPlate = art.find((piece) => piece.order === 1)!;

// Rendered by hand from getImage so the <img> and the preload in <head>
// share one srcset — a preload that doesn't match is a wasted request.
const heroSizes = '(min-width: 900px) 48vw, 100vw';
const heroImage = await getImage({
	src: heroPlate.src,
	widths: [640, 960, 1280, 1440],
	sizes: heroSizes,
});

const projectRoles: Record<string, string> = {
	'shop-with-google': 'Lead Video Editor',
	nuuly: 'Video Editor / Motion Designer',
	'under-armour': 'Video Editor',
	'kate-spade': 'Video Editor'
};
---

<BaseLayout
	title="Photography, Film & Design"
	description="Photographs and commercial film by Colton Batts, Fort Worth. Design and software in support."
>
	<link
		slot="head"
		rel="preload"
		as="image"
		imagesrcset={heroImage.srcSet.attribute}
		imagesizes={heroSizes}
		fetchpriority="high"
	/>

	<section class="monograph-hero" data-motion-chapter>
		<div class="monograph-hero__copy">
			<h1><span>Colton</span><span>Batts</span></h1>
			<p class="monograph-hero__statement"><span>Images with consequence.</span> <span>Systems with a point of view.</span></p>
		</div>

		<figure class="monograph-hero__image">
			<img
				src={heroImage.src}
				srcset={heroImage.srcSet.attribute}
				sizes={heroSizes}
				alt={heroPlate.alt}
				width={heroPlate.src.width}
				height={heroPlate.src.height}
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
			<figcaption>{heroPlate.title}, {heroPlate.year}</figcaption>
		</figure>
	</section>

	<section id="art" class="art-edition" data-motion-chapter>
		<header class="art-edition__intro">
			<h2>Art<br /><em>first.</em></h2>
		</header>

		<div class="art-sheet art-sheet--ledger">
			{featuredArt.map((piece) => (
				<ArtPlate piece={piece} size="ledger" />
			))}
		</div>

		<a class="art-edition__cta" href="/art">
			Open the art archive <span aria-hidden="true">→</span>
		</a>
	</section>

	<section id="work" class="edition-intro" data-motion-chapter>
		<h2>Selected<br /><em>work</em></h2>
	</section>

	<section class="project-editions" aria-label="Selected projects">
		{projects.map((project) => (
			<a href={`/portfolio/${project.id}`} class="project-edition" data-reveal>
				<header class="project-edition__head">
					<h3>{project.data.title}</h3>
					<p>{projectRoles[project.id] || project.data.medium}<br />{project.data.dimensions} · {project.data.year}</p>
				</header>

				<div class="project-edition__media">
					<WorkMedia
						title={project.data.title}
						poster={project.data.poster}
						posterAlt={project.data.posterAlt}
						loop={project.data.loop}
						vimeoId={project.data.vimeoId}
					/>
				</div>
			</a>
		))}
	</section>

	<section class="dark-relic" data-motion-chapter>
		<div class="dark-relic__copy">
			<h2>Image.<br />Sequence.<br /><em>System.</em></h2>
			<p>I move between filmmaking, graphic design, and software because the most interesting work rarely stays inside one medium.</p>
		</div>

		<figure class="dark-relic__portrait">
			<Image
				src={heroMovement}
				alt="Figure in a white shirt with a vermilion beam crossing their eyes"
				widths={[480, 720, 960]}
				sizes="(max-width: 700px) 90vw, 42vw"
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<ol class="discipline-ledger">
			<li><h3>Film & Motion</h3><p>Editorial, campaign film, kinetic type, and motion systems.</p></li>
			<li><h3>Design</h3><p>Art direction, identity, launch graphics, and production frameworks.</p></li>
			<li><h3>Technology</h3><p>Purpose-built software and interfaces for people who make things.</p></li>
		</ol>
	</section>

	<section class="tool-editions" data-motion-chapter>
		<header class="tool-editions__intro">
			<h2>Tools for<br /><em>the work.</em></h2>
		</header>

		<div class="tool-editions__list">
			{tools.map((tool) => (
				<a href={tool.data.externalUrl || `/tools/${tool.id}`} class="tool-edition" data-reveal>
					<div class="tool-edition__media">
						{tool.data.heroImage ? (
							<Image src={tool.data.heroImage} alt={`${tool.data.name} interface`} widths={[560, 900]} sizes="(max-width: 700px) 100vw, 45vw" loading="lazy" decoding="async" />
						) : <div>{tool.data.name}</div>}
					</div>
					<div class="tool-edition__text">
						<p class="studio-kicker">{tool.data.status} · {tool.data.platform}</p>
						<h3>{tool.data.name}</h3>
						<p>{tool.data.oneLiner}</p>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="client-ledger" data-motion-chapter>
		<p class="studio-kicker">Selected clients</p>
		<div><span>Google</span><span>Nuuly</span><span>Under Armour</span><span>Kate Spade</span></div>
	</section>

	<section class="closing-poster" data-motion-chapter>
		<h2>Make something<br /><em>worth keeping.</em></h2>
		<a href="mailto:colton.batts@gmail.com">
			<span>Start a conversation</span>
			<span class="closing-poster__email">colton.batts@gmail.com <span aria-hidden="true">↗</span></span>
		</a>
	</section>

</BaseLayout>
