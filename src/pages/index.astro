---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('paintings')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Film & Motion"
	description="Colton Batts — film and motion. Fort Worth."
	cover
>
	<section class="book-cover" aria-label="Cover">
		<div class="book-cover__board" aria-hidden="true"></div>
		<div class="book-cover__wear" aria-hidden="true"></div>

		<div class="book-cover__face">
			<p class="book-cover__place">Fort Worth</p>
			<h1 class="book-cover__title">
				<span>Colton</span>
				<span>Batts</span>
			</h1>
			<hr class="book-cover__rule" />
			<p class="book-cover__line">Images with consequence.</p>

			<nav class="book-cover__spine" aria-label="Enter">
				<a href="#interior">Work</a>
				<a href="/contact">Contact</a>
			</nav>
		</div>
	</section>

	<section id="interior" class="book-interior">
		<header class="book-interior__head">
			<p>Work</p>
		</header>

		<ul class="book-spine-list">
			{projects.map((project) => (
				<li>
					<a href={`/portfolio/${project.id}`}>
						<span class="book-spine-list__title">{project.data.title}</span>
						<span class="book-spine-list__meta">
							{project.data.medium} · {project.data.year}
						</span>
					</a>
				</li>
			))}
		</ul>

		<p class="book-interior__more">
			<a href="/portfolio">All work</a>
			<span aria-hidden="true">·</span>
			<a href="/tools">Tools</a>
			<span aria-hidden="true">·</span>
			<a href="mailto:colton.batts@gmail.com">colton.batts@gmail.com</a>
		</p>
	</section>
</BaseLayout>
