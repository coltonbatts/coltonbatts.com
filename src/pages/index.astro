---
/**
 * index.astro — Homepage
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const paintings = (await getCollection('paintings')).sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools')).slice(0, 2);

const trustedByLogos = [
	{ key: 'nuuly', name: 'Nuuly', src: '/brands/nuuly.png' },
	{ key: 'kate-spade', name: 'Kate Spade', src: '/brands/kate-spade.png' },
	{ key: 'under-armour', name: 'Under Armour', src: '/brands/under-armour.png' },
	{ key: 'google-shopping', name: 'Google Shopping', src: '/brands/google-shopping.png' }
];

const projectRoles: Record<string, string> = {
	'shop-with-google': 'Lead Video Editor',
	nuuly: 'Video Editor / Motion Designer',
	'under-armour': 'Video Editor',
	'kate-spade': 'Video Editor'
};

const heroCollage = [
	{
		src: '/art/hero/hero-01.png',
		alt: 'Printed campaign image treatment with figures and red editorial texture',
		className: 'editorial-collage__image editorial-collage__image--lead'
	},
	{
		src: '/art/hero/coltonbatts_woman_performing_modern_dance._in_the_style_of_expe_a80a583a-3c5c-44f2-b6a9-c71c18d2e1eb.png',
		alt: 'Movement study cropped as a red duotone editorial image',
		className: 'editorial-collage__image editorial-collage__image--tall'
	},
	{
		src: '/art/motion/motion-poster.png',
		alt: 'Motion poster artwork treated like a printed studio proof',
		className: 'editorial-collage__image editorial-collage__image--wide'
	}
];

const projectFallbackImages: Record<string, string> = {
	'under-armour': '/art/hero/coltonbatts_peaople_reaching_for_nike_jordan_shoes_that_are_a_80a3e748-7622-4221-972d-f94f53599962_2.png',
	'kate-spade': '/art/hero/coltonbatts_woman_performing_modern_dance._in_the_style_of_expe_a80a583a-3c5c-44f2-b6a9-c71c18d2e1eb.png'
};
---

<BaseLayout
	title="Graphic Design Systems"
	description="Motion-led campaigns, editorial systems, launch assets, and production-ready digital tools by Colton Batts."
>
	<section class="studio-hero hero-section" data-motion-chapter>
		<div class="studio-hero__copy">
			<div class="studio-hero__meta" aria-label="Studio metadata">
				<p class="studio-kicker">Colton Batts / Senior Graphic + Motion Designer</p>
				<p class="studio-kicker">Campaign / Motion / Editorial Systems</p>
			</div>
			<h1>I enjoy graphic design systems.</h1>
			<p>Motion-led campaigns, editorial systems, launch assets, and production-ready digital tools.</p>
			<div class="studio-hero__actions" aria-label="Primary actions">
				<a href="#work" class="btn-instrument">View Work</a>
				<a href="mailto:colton.batts@gmail.com" class="btn-instrument btn-instrument--raw">Email</a>
			</div>
			<div class="studio-hero__scene editorial-collage" aria-label="Editorial portfolio image collage">
				<div class="editorial-collage__rule editorial-collage__rule--one" aria-hidden="true"></div>
				<div class="editorial-collage__rule editorial-collage__rule--two" aria-hidden="true"></div>
				{heroCollage.map((image) => (
					<figure class={image.className}>
						<img src={image.src} alt={image.alt} loading="eager" decoding="async" />
					</figure>
				))}
				<p class="editorial-collage__caption">Selected image systems / campaign motion / studio tools</p>
				<span class="editorial-collage__folio" aria-hidden="true">CB-01</span>
			</div>
		</div>
	</section>

	<section class="studio-marquee" aria-label="Selected disciplines" data-motion-chapter>
		<div class="studio-marquee__row">
			<span>Motion Systems</span>
			<span>Campaign Editorial</span>
			<span>Launch Assets</span>
			<span>Production Tools</span>
			<span aria-hidden="true">Motion Systems</span>
			<span aria-hidden="true">Campaign Editorial</span>
			<span aria-hidden="true">Launch Assets</span>
			<span aria-hidden="true">Production Tools</span>
		</div>
	</section>

	<section class="studio-proof" aria-label="Select clients" data-motion-chapter>
		<p class="studio-kicker">Client Proof</p>
		<div class="studio-proof__logos">
			{trustedByLogos.map((logo) => (
				<div class="trusted-logo-wrap studio-proof__logo">
					<img
						src={logo.src}
						alt={logo.name}
						loading="lazy"
						decoding="async"
						class={`trusted-logo-image trusted-logo-image--${logo.key}`}
					/>
				</div>
			))}
		</div>
	</section>

	<section id="work" class="studio-section studio-work" data-motion-chapter>
		<div class="studio-section__header">
			<p class="studio-kicker">Featured Work</p>
			<h2>Campaigns, launch systems, and motion assets for teams that ship.</h2>
		</div>

		<div class="studio-work__list">
			{paintings.map((project, index) => (
				<a
					href={`/portfolio/${project.slug}`}
					class="studio-project"
					data-reveal
					style={`--project-index:${index};`}
				>
					<div class="studio-project__index">
						<span>{String(index + 1).padStart(2, '0')}</span>
						<em>{project.data.series}</em>
					</div>
					<div class="studio-project__media">
						{project.data.vimeoId ? (
							<div class="studio-project__video">
								<iframe
									data-src={`https://player.vimeo.com/video/${project.data.vimeoId}?background=1&autoplay=0&loop=1&muted=1&dnt=1`}
									allow="autoplay; fullscreen"
									loading="lazy"
									title={`${project.data.title} motion sample`}
								></iframe>
							</div>
						) : projectFallbackImages[project.slug] ? (
							<img
								src={projectFallbackImages[project.slug]}
								alt={`${project.data.title} editorial image treatment`}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="studio-project__plate" aria-label={`${project.data.title} production plate`}>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<strong>{project.data.title}</strong>
								<em>{project.data.series}</em>
							</div>
						)}
					</div>
					<div class="studio-project__info">
						<p class="studio-kicker">Case Study / {String(index + 1).padStart(2, '0')}</p>
						<h3>{project.data.title}</h3>
						<dl>
							<div>
								<dt>Client</dt>
								<dd>{project.data.title}</dd>
							</div>
							<div>
								<dt>Role</dt>
								<dd>{projectRoles[project.slug] || project.data.medium}</dd>
							</div>
							<div>
								<dt>Year</dt>
								<dd>{project.data.year}</dd>
							</div>
							<div>
								<dt>Medium</dt>
								<dd>{project.data.dimensions}</dd>
							</div>
						</dl>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="studio-section studio-capabilities" data-motion-chapter>
		<div class="studio-capabilities__item" data-reveal>
			<p class="studio-kicker">01</p>
			<h2>Brand Campaigns</h2>
			<p>Launch graphics, social systems, retail assets, and high-volume production packages.</p>
		</div>
		<div class="studio-capabilities__item" data-reveal>
			<p class="studio-kicker">02</p>
			<h2>Motion Design</h2>
			<p>Kinetic type, editorial rhythm, social cutdowns, animated identity moments, and video systems.</p>
		</div>
		<div class="studio-capabilities__item" data-reveal>
			<p class="studio-kicker">03</p>
			<h2>Digital Tools</h2>
			<p>Production-minded interfaces and software experiments built with the same visual discipline.</p>
		</div>
	</section>

	<section class="studio-point" data-motion-chapter>
		<p class="studio-kicker">Point of View</p>
		<h2>Systems that survive deadlines.</h2>
		<p>
			Design and motion work best when they share one production language: durable assets,
			clear handoffs, disciplined hierarchy, and files built for real teams.
		</p>
	</section>

	<section class="studio-section studio-lab" data-motion-chapter>
		<div class="studio-section__header">
			<p class="studio-kicker">Motion / Lab</p>
			<h2>Interactive studies as production evidence.</h2>
		</div>
		<div class="studio-lab__grid">
			{tools.map((tool, index) => (
				<a href={`/tools/${tool.slug}`} class="studio-lab__item" data-reveal style={`--project-index:${index};`}>
					<div class="studio-lab__media">
						{tool.data.heroImage ? (
							<img src={tool.data.heroImage} alt={`${tool.data.name} interface preview`} loading="lazy" decoding="async" />
						) : (
							<div>{tool.data.name}</div>
						)}
					</div>
					<div class="studio-lab__info">
						<p class="studio-kicker">{tool.data.status} / {tool.data.platform}</p>
						<h3>{tool.data.name}</h3>
						<p>{tool.data.oneLiner}</p>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="studio-contact" data-motion-chapter>
		<p class="studio-kicker">Contact</p>
		<h2>Campaign system, motion package, launch asset sprint, or production tool.</h2>
		<a href="mailto:colton.batts@gmail.com" class="btn-instrument">Email Colton</a>
	</section>

	<script>
		function initStudioReveals() {
			const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
			if (!elements.length) return;

			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduced) {
				elements.forEach((element) => {
					element.classList.add('reveal', 'reveal--visible', 'reveal--instant');
				});
				return;
			}

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('reveal--visible');
					observer.unobserve(entry.target);
				});
			}, { threshold: 0.18, rootMargin: '0px 0px -12% 0px' });

			elements.forEach((element, index) => {
				if (element.dataset.studioRevealReady === 'true') return;
				element.dataset.studioRevealReady = 'true';
				element.classList.add('reveal');
				element.style.transitionDelay = `${Math.min(index % 4, 3) * 70}ms`;
				observer.observe(element);
			});
		}

		function initStudioVideos() {
			const players = document.querySelectorAll<HTMLIFrameElement>('.studio-project__video iframe');
			if (!players.length) return;

			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduced) return;

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					const iframe = entry.target as HTMLIFrameElement;
					if (entry.isIntersecting && iframe.dataset.src && !iframe.src) {
						iframe.src = iframe.dataset.src.replace('autoplay=0', 'autoplay=1');
					}
				});
			}, { threshold: 0.22, rootMargin: '160px 0px' });

			players.forEach((player) => observer.observe(player));
		}

		initStudioReveals();
		initStudioVideos();
		document.addEventListener('astro:page-load', initStudioReveals);
		document.addEventListener('astro:page-load', initStudioVideos);
	</script>
</BaseLayout>
