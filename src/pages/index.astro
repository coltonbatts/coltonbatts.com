---
/**
 * index.astro — Homepage
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import heroLead from '../assets/hero/hero-01.png';
import heroMovement from '../assets/hero/movement-study.png';
import underArmourFallback from '../assets/hero/under-armour-fallback.png';

const paintings = (await getCollection('paintings')).sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools')).slice(0, 2);

const projectRoles: Record<string, string> = {
	'shop-with-google': 'Lead Video Editor',
	nuuly: 'Video Editor / Motion Designer',
	'under-armour': 'Video Editor',
	'kate-spade': 'Video Editor'
};

const projectFallbackImages: Record<string, ImageMetadata> = {
	'under-armour': underArmourFallback,
	'kate-spade': heroMovement
};
---

<BaseLayout
	title="Filmmaker, Designer & Creative Technologist"
	description="Selected films, design systems, and independent digital tools by Colton Batts."
>
	<section class="exhibition-hero" data-motion-chapter>
		<div class="exhibition-hero__masthead">
			<p class="studio-kicker">Portfolio / Volume I</p>
			<p class="exhibition-hero__intro">Independent practice across moving image, graphic systems, and software—built with care in Chicago.</p>
			<h1>Colton<br />Batts</h1>
			<p class="exhibition-hero__roles"><span>Filmmaker</span><span>Designer</span><span>Creative Technologist</span></p>
		</div>
		<figure class="exhibition-hero__image" data-parallax>
			<Image src={heroLead} alt="Figures walking through a dark landscape, rendered in deep olive and rust" widths={[960, 1440, 1920]} sizes="100vw" loading="eager" decoding="async" />
			<figcaption><span>Fig. 01</span><span>Movement / memory / repetition</span><span>Studio image, 2026</span></figcaption>
		</figure>
	</section>

	<section id="work" class="work-index" data-motion-chapter>
		<header class="section-heading">
			<p class="studio-kicker">Selected Works / 2022—2026</p>
			<h2>Work for screens,<br /><em>systems for people.</em></h2>
			<p>Commercial films, editorial campaigns, and designed tools. Each project begins with the same question: what is essential?</p>
		</header>

		<div class="work-index__list">
			{paintings.map((project, index) => (
				<a
					href={`/portfolio/${project.id}`}
					class="work-entry"
					data-reveal
					style={`--project-index:${index};`}
				>
					<div class="work-entry__media">
						{project.data.vimeoId ? (
							<div class="work-entry__video">
								<iframe
									data-src={`https://player.vimeo.com/video/${project.data.vimeoId}?background=1&autoplay=0&loop=1&muted=1&dnt=1`}
									allow="autoplay; fullscreen"
									loading="lazy"
									title={`${project.data.title} motion sample`}
								></iframe>
							</div>
						) : projectFallbackImages[project.id] ? (
							<Image
								src={projectFallbackImages[project.id]}
								alt={`${project.data.title} editorial image treatment`}
								widths={[480, 800, 1200]}
								sizes="(max-width: 768px) 90vw, 60vw"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="work-entry__plate" aria-label={`${project.data.title} production plate`}>
								<span>Archive / {String(index + 1).padStart(2, '0')}</span>
								<strong>{project.data.title}</strong>
							</div>
						)}
					</div>
					<div class="work-entry__info">
						<p class="work-entry__number">{String(index + 1).padStart(2, '0')}</p>
						<h3>{project.data.title}</h3>
						<p>{projectRoles[project.id] || project.data.medium}<br />{project.data.dimensions} / {project.data.year}</p>
						<span class="work-entry__link">View case study ↗</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="practice-statement" data-motion-chapter>
		<div class="practice-statement__aside">
			<p class="studio-kicker">Practice / No. 03</p>
			<Image src={heroMovement} alt="Figure in a white shirt with a red beam crossing their eyes" widths={[400, 720]} sizes="(max-width: 768px) 80vw, 28vw" loading="lazy" decoding="async" />
		</div>
		<div class="practice-statement__text">
			<p class="studio-kicker">A point of view</p>
			<h2>Craft is not a finish.<br /><em>It is the method.</em></h2>
			<p>I work between filmmaking, graphic design, and creative technology—building visual languages that hold up under real conditions. Clear enough for a team. Distinct enough to be remembered.</p>
		</div>
	</section>

	<section class="capability-index" data-motion-chapter>
		<header>
			<p class="studio-kicker">Disciplines</p>
			<h2>One practice.<br />Three lenses.</h2>
		</header>
		<ol>
			<li><span>01</span><h3>Film & Motion</h3><p>Editorial, campaign film, kinetic type, and motion systems.</p></li>
			<li><span>02</span><h3>Design Systems</h3><p>Art direction, identity, launch graphics, and production frameworks.</p></li>
			<li><span>03</span><h3>Creative Technology</h3><p>Purpose-built software and interfaces for people who make things.</p></li>
		</ol>
	</section>

	<section class="studio-lab" data-motion-chapter>
		<div class="section-heading section-heading--compact">
			<p class="studio-kicker">Independent Tools / Field Notes</p>
			<h2>Tools made<br /><em>for the studio.</em></h2>
		</div>
		<div class="studio-lab__grid">
			{tools.map((tool, index) => (
				<a href={tool.data.externalUrl || `/tools/${tool.id}`} class="studio-lab__item" data-reveal style={`--project-index:${index};`}>
					<div class="studio-lab__media">
						{tool.data.heroImage ? (
							<Image
								src={tool.data.heroImage}
								alt={`${tool.data.name} interface preview`}
								widths={[480, 800]}
								sizes="(max-width: 768px) 90vw, 45vw"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div>{tool.data.name}</div>
						)}
					</div>
					<div class="studio-lab__info">
						<p class="studio-kicker">{String(index + 1).padStart(2, '0')} / {tool.data.status} / {tool.data.platform}</p>
						<h3>{tool.data.name}</h3>
						<p>{tool.data.oneLiner}</p>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="client-index" data-motion-chapter>
		<p class="studio-kicker">Selected Clients</p>
		<p><span>Google</span><span>Nuuly</span><span>Under Armour</span><span>Kate Spade</span></p>
	</section>

	<section class="studio-contact" data-motion-chapter>
		<p class="studio-kicker">Open for selected projects / 2026</p>
		<h2>Have something<br /><em>worth making?</em></h2>
		<a href="mailto:colton.batts@gmail.com">Start a conversation <span>↗</span></a>
	</section>

	<script>
		function initHomeVideos() {
			const players = document.querySelectorAll<HTMLIFrameElement>('.work-entry__video iframe');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (players.length && !reduced) {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						const iframe = entry.target as HTMLIFrameElement;
						if (entry.isIntersecting && iframe.dataset.src && !iframe.src) {
							iframe.src = iframe.dataset.src.replace('autoplay=0', 'autoplay=1');
						}
					});
				}, { threshold: 0.22, rootMargin: '160px 0px' });
				players.forEach((player) => observer.observe(player));
			}
		}

		document.addEventListener('astro:page-load', initHomeVideos);
	</script>
</BaseLayout>
