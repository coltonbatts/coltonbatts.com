---
import { Image } from 'astro:assets';
import { site } from '../config';
import { art } from '../data/art';
import resume from '../data/resume_source.json';
import '../styles/lux.css';

import heroPlate from '../assets/art/01-untitled-2021.png';
import stillPrimary from '../assets/art/02-365-256.png';
import stillSecondary from '../assets/art/19-thinking-about-cotton-candy.png';
import stillTertiary from '../assets/art/23-untitled-2021.png';

const films = [
	{
		client: 'Shop with Google',
		role: 'Lead Editor — 30+ campaign cuts',
		year: '2023',
		vimeoId: '1121660660',
		aspect: 'landscape' as const,
		caseStudy: '/portfolio/shop-with-google',
	},
	{
		client: 'Nuuly',
		role: 'Editor & Motion',
		year: '2023',
		vimeoId: '1122006774',
		aspect: 'landscape' as const,
		caseStudy: '/portfolio/nuuly',
	},
	{
		client: 'Under Armour',
		role: 'Lead Editor — Brand training series',
		year: '2022',
		vimeoId: null,
		aspect: 'landscape' as const,
		caseStudy: null,
	},
	{
		client: 'Kate Spade',
		role: 'Motion Systems',
		year: '2023',
		vimeoId: null,
		aspect: 'landscape' as const,
		caseStudy: null,
	},
];

const instruments = [
	{
		name: 'VCR',
		spec: 'Rust, Metal',
		description:
			'Headless motion renderer for Apple Silicon. Declarative YAML scenes rendered directly to ProRes 4444 with straight alpha.',
		vimeoId: '1166117135',
		vimeoAspect: 'vertical' as const,
		links: [{ label: 'GitHub', href: 'https://github.com/coltonbatts/VCR', external: true }],
	},
	{
		name: 'ColorWizard',
		spec: 'Web, macOS',
		description:
			'Spectral color instrument translating any reference pixel into physical oil-paint recipes and DMC thread matches via Kubelka–Munk optics.',
		vimeoId: null,
		vimeoAspect: null,
		links: [
			{ label: 'Launch', href: 'https://colorwizard.app/', external: true },
			{ label: 'GitHub', href: 'https://github.com/coltonbatts/colorwizard', external: true },
		],
	},
	{
		name: 'MagpieApp',
		spec: 'Tauri, Rust',
		description:
			'Offline embroidery engine that transforms photographs into thread-matched hand-embroidery blueprints for studio production.',
		vimeoId: null,
		vimeoAspect: null,
		links: [
			{ label: 'Overview', href: '/tools/magpie', external: false },
			{ label: 'GitHub', href: 'https://github.com/coltonbatts/MagpieApp', external: true },
		],
	},
	{
		name: 'Capture This Coffee',
		spec: 'Web application',
		description:
			'Live crew intake and barista batching workflow built for high-tempo commercial production sets.',
		vimeoId: null,
		vimeoAspect: null,
		links: [{ label: 'Live', href: 'https://coffee.capturethis.com', external: true }],
	},
];

const stills = [
	{
		src: stillPrimary,
		title: '365 / 256',
		year: '2021',
		alt: 'A street lamp with a red bulb on a foggy night, a draped white cloth figure standing beneath it.',
		slot: 'primary',
	},
	{
		src: stillSecondary,
		title: 'Thinking About Cotton Candy',
		year: '2022',
		alt: 'A figure in violet smoke suspended in a foggy field beside a transmission tower.',
		slot: 'secondary',
	},
	{
		src: stillTertiary,
		title: 'Untitled',
		year: '2021',
		alt: 'Monochrome photograph of a figure with outstretched arms and a cloud of white smoke.',
		slot: 'tertiary',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={site.description} />
		<link rel="icon" type="image/png" href="/favicon-custom.png" />

		<link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/InstrumentSerif-Italic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />

		<title>Colton Batts</title>
	</head>

	<body>
		<a class="lux-skip" href="#main">Skip to content</a>

		<header class="lux-header">
			<div class="lux-wrap">
				<nav class="lux-nav" aria-label="Primary">
					<a href="/lux" class="lux-brand">Colton Batts</a>
					<ul class="lux-nav__links">
						<li><a href="#film">Film</a></li>
						<li><a href="#instruments">Instruments</a></li>
						<li><a href="#stills">Stills</a></li>
						<li><a href="#information">Information</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<!-- Movement I — Opening -->
			<section class="lux-hero">
				<div class="lux-wrap">
					<h1 class="lux-hero__statement">
						Video editor and motion designer<br />who <em>builds the tools.</em>
					</h1>

					<div class="lux-hero__meta">
						<span>Fort Worth, Texas — Available for full-time roles &amp; select commissions</span>
						<a class="lux-link" href={`mailto:${site.email}`}>{site.email}</a>
					</div>

					<figure class="lux-hero__plate-wrap" style="margin-inline: 0; margin-bottom: 0;">
						<button
							type="button"
							class="lux-hero__plate-btn"
							data-lightbox-src={heroPlate.src}
							data-lightbox-title="Suburban Gothic, 2021"
							data-lightbox-alt="A dark house at night; one window glows red, a white cloth form hangs in the yard."
							aria-label="Inspect Suburban Gothic, 2021"
						>
							<Image
								src={heroPlate}
								alt="A dark house at night; one window glows red, a white cloth form hangs in the yard."
								widths={[900, 1440, 2000]}
								sizes="(max-width: 900px) 92vw, 1240px"
								loading="eager"
								fetchpriority="high"
								decoding="async"
								class="lux-hero__plate-img"
							/>
						</button>
						<figcaption class="lux-caption">
							<span class="lux-caption__title">Suburban Gothic</span>
							<span>2021</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<!-- Movement II — Selected Film -->
			<section id="film" class="lux-section" aria-labelledby="film-heading">
				<div class="lux-wrap">
					<div class="lux-grid">
						<div class="lux-rail">
							<h2 id="film-heading" class="lux-label">Selected Film</h2>
						</div>

						<div class="lux-content" data-lux-reveal>
							<ol class="lux-ledger">
								{films.map((film) => (
									<li class="lux-ledger__row">
										<h3 class="lux-ledger__title">{film.client}</h3>
										<span class="lux-ledger__role">{film.role}</span>
										<span class="lux-ledger__year">{film.year}</span>
										<div class="lux-ledger__actions">
											{film.vimeoId ? (
												<button
													type="button"
													class="lux-link"
													data-screen-vimeo={film.vimeoId}
													data-screen-title={`${film.client} — ${film.year}`}
													data-screen-aspect={film.aspect}
												>
													Screen ↗
												</button>
											) : (
												<a
													class="lux-link lux-link--muted"
													href={`mailto:${site.email}?subject=${encodeURIComponent(`Private screener — ${film.client}`)}`}
												>
													On request
												</a>
											)}
										</div>
									</li>
								))}
							</ol>

							<div class="lux-ledger__foot">
								<span>Capture This Agency &amp; direct commissions</span>
								<a class="lux-link lux-link--muted" href="/portfolio">Archive</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Movement III — Instruments / Software -->
			<section id="instruments" class="lux-section" aria-labelledby="instruments-heading">
				<div class="lux-wrap">
					<div class="lux-grid">
						<div class="lux-rail">
							<h2 id="instruments-heading" class="lux-label">Instruments</h2>
						</div>

						<div class="lux-content">
							<div class="lux-instruments">
								{instruments.map((item) => (
									<article class="lux-instrument" data-lux-reveal>
										<div class="lux-instrument__head">
											<h3 class="lux-instrument__name">{item.name}</h3>
											<span class="lux-instrument__spec">{item.spec}</span>
										</div>

										<p class="lux-instrument__desc">{item.description}</p>

										<div class="lux-instrument__links">
											{item.vimeoId && (
												<button
													type="button"
													class="lux-link"
													data-screen-vimeo={item.vimeoId}
													data-screen-title={`${item.name} — Film`}
													data-screen-aspect={item.vimeoAspect ?? 'landscape'}
												>
													Film ↗
												</button>
											)}
											{item.links.map((link) => (
												<a
													class="lux-link lux-link--muted"
													href={link.href}
													target={link.external ? '_blank' : undefined}
													rel={link.external ? 'noopener noreferrer' : undefined}
												>
													{link.label}{link.external ? ' ↗' : ''}
												</a>
											))}
										</div>
									</article>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Movement IV — Stills (Curated Gallery Wall) -->
			<section id="stills" class="lux-section" aria-labelledby="stills-heading">
				<div class="lux-wrap">
					<div class="lux-stills__head">
						<h2 id="stills-heading" class="lux-label">Stills — Fort Worth, 2021–2022</h2>
						<a class="lux-link lux-link--muted" href="/art" style="font-size: 0.8125rem;">
							Full archive ({art.length})
						</a>
					</div>

					<div class="lux-stills__wall">
						{stills.map((piece) => (
							<figure class={`lux-print lux-print--${piece.slot}`} data-lux-reveal>
								<button
									type="button"
									class="lux-print__trigger"
									data-lightbox-src={piece.src.src}
									data-lightbox-title={`${piece.title}, ${piece.year}`}
									data-lightbox-alt={piece.alt}
									aria-label={`Inspect ${piece.title}, ${piece.year}`}
								>
									<Image
										src={piece.src}
										alt={piece.alt}
										widths={[600, 1080, 1440]}
										sizes={piece.slot === 'primary' ? '(max-width: 720px) 92vw, 54vw' : '(max-width: 720px) 92vw, 38vw'}
										loading="lazy"
										decoding="async"
										class="lux-print__img"
									/>
								</button>
								<figcaption class="lux-caption">
									<span class="lux-caption__title">{piece.title}</span>
									<span>{piece.year}</span>
								</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>

			<!-- Movement V — Information -->
			<section id="information" class="lux-section" aria-labelledby="info-heading">
				<div class="lux-wrap">
					<div class="lux-info">
						<div class="lux-grid">
							<div class="lux-rail">
								<h2 id="info-heading" class="lux-label">Information</h2>
							</div>

							<div class="lux-content">
								<div class="lux-info__cols">
									<div data-lux-reveal>
										<p class="lux-info__subhead">Experience</p>
										<ol class="lux-cv">
											{resume.experience.map((role) => (
												<li class="lux-cv__item">
													<div>
														<div class="lux-cv__role">{role.title}</div>
														<div class="lux-cv__org">{role.company.replace(/\s*\(.*?\)\s*/g, '')}</div>
													</div>
													<span class="lux-cv__dates">{role.dates.replace('–', '—')}</span>
												</li>
											))}
										</ol>
										<div class="lux-cv__links">
											<a class="lux-link" href="/resume">Curriculum Vitae</a>
											<a class="lux-link lux-link--muted" href="/resume/Colton_Batts_Resume.pdf">PDF ↗</a>
										</div>
									</div>

									<div data-lux-reveal>
										<p class="lux-info__subhead">Inquiries</p>
										<a class="lux-contact__email" href={`mailto:${site.email}`}>
											{site.email}
										</a>
										<p class="lux-contact__note">
											Fort Worth, Texas. Open to full-time roles and select commercial, motion, or creative-technology commissions worldwide.
										</p>
										<div class="lux-contact__links">
											<a class="lux-link lux-link--muted" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
											<a class="lux-link lux-link--muted" href="/portfolio">Work</a>
											<a class="lux-link lux-link--muted" href="/tools">Tools</a>
											<a class="lux-link lux-link--muted" href="/art">Archive</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="lux-footer">
			<div class="lux-wrap">
				<div class="lux-footer__inner">
					<span>Colton Batts</span>
					<span>32.7555° N, 97.3308° W</span>
					<span>&copy; {new Date().getFullYear()}</span>
				</div>
			</div>
		</footer>

		<!-- Obsidian Screening Room & Lightbox -->
		<div class="lux-modal" data-lux-modal role="dialog" aria-modal="true" aria-hidden="true">
			<div class="lux-modal__bar">
				<span class="lux-modal__title" data-lux-modal-title></span>
				<button type="button" class="lux-modal__close" data-lux-modal-close>Close</button>
			</div>
			<div class="lux-modal__stage" data-lux-modal-stage></div>
		</div>

		<script>
			const modal = document.querySelector<HTMLElement>('[data-lux-modal]');
			const modalTitle = document.querySelector<HTMLElement>('[data-lux-modal-title]');
			const modalStage = document.querySelector<HTMLElement>('[data-lux-modal-stage]');
			const modalClose = document.querySelector<HTMLButtonElement>('[data-lux-modal-close]');
			let lastTrigger: HTMLElement | null = null;

			function openModal(title: string, content: HTMLElement, trigger: HTMLElement | null) {
				if (!modal || !modalTitle || !modalStage) return;
				lastTrigger = trigger;
				modalTitle.textContent = title;
				modalStage.replaceChildren(content);
				modal.classList.add('is-open');
				modal.setAttribute('aria-hidden', 'false');
				document.body.classList.add('is-modal-open');
				modalClose?.focus();
			}

			function closeModal() {
				if (!modal || !modalStage) return;
				if (!modal.classList.contains('is-open')) return;
				modal.classList.remove('is-open');
				modal.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('is-modal-open');
				window.setTimeout(() => {
					if (!modal.classList.contains('is-open')) {
						modalStage.replaceChildren();
					}
				}, 400);
				lastTrigger?.focus();
				lastTrigger = null;
			}

			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement | null;
				if (!target) return;

				const screenBtn = target.closest<HTMLElement>('[data-screen-vimeo]');
				if (screenBtn) {
					const id = screenBtn.dataset.screenVimeo;
					const title = screenBtn.dataset.screenTitle || 'Screening';
					const aspect = screenBtn.dataset.screenAspect;
					if (!id) return;

					const wrap = document.createElement('div');
					wrap.className = aspect === 'vertical' ? 'lux-modal__video lux-modal__video--vertical' : 'lux-modal__video';
					const iframe = document.createElement('iframe');
					iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
					iframe.allow = 'autoplay; fullscreen; picture-in-picture';
					iframe.title = title;
					wrap.appendChild(iframe);
					openModal(title, wrap, screenBtn);
					return;
				}

				const photoBtn = target.closest<HTMLElement>('[data-lightbox-src]');
				if (photoBtn) {
					const src = photoBtn.dataset.lightboxSrc;
					const title = photoBtn.dataset.lightboxTitle || '';
					const alt = photoBtn.dataset.lightboxAlt || title;
					if (!src) return;

					const img = document.createElement('img');
					img.src = src;
					img.alt = alt;
					img.className = 'lux-modal__photo';
					openModal(title, img, photoBtn);
					return;
				}

				if (target.closest('[data-lux-modal-close]') || target === modalStage) {
					closeModal();
				}
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closeModal();
			});

			/* Quiet scroll settle */
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const nodes = document.querySelectorAll<HTMLElement>('[data-lux-reveal]');
			if (reduced || !('IntersectionObserver' in window)) {
				nodes.forEach((n) => n.classList.add('is-in'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						});
					},
					{ threshold: 0.08, rootMargin: '0px 0px -4% 0px' }
				);
				nodes.forEach((n) => io.observe(n));
			}
		</script>
	</body>
</html>
