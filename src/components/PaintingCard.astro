---
import type { ImageMetadata } from 'astro';
import WorkMedia from './WorkMedia.astro';

interface Props {
	title: string;
	medium: string;
	dimensions: string;
	year: number;
	image?: string;
	slug: string;
	featured?: boolean;
	available?: boolean;
	series?: string;
	vimeoId?: string;
	poster?: ImageMetadata;
	posterAlt?: string;
	loop?: string;
	class?: string;
}

const {
	title,
	medium,
	dimensions,
	year,
	image,
	slug,
	featured = false,
	available = false,
	series,
	vimeoId,
	poster,
	posterAlt,
	loop,
	class: className = '',
} = Astro.props;
---

<a
	href={`/portfolio/${slug}`}
	class:list={[
		'painting-card group block',
		{ 'painting-card--featured': featured },
		className,
	]}
>
	<div class="painting-card__frame">
		<div class="painting-card__mat">
			<WorkMedia
				title={title}
				poster={poster}
				posterAlt={posterAlt}
				loop={loop}
				vimeoId={vimeoId}
			/>
		</div>
	</div>

	<div class="painting-card__label">
		<h2 class="painting-card__title">
			{title}
			{available && <span class="painting-card__available" title="Available">●</span>}
		</h2>
		<p class="painting-card__meta">
			{medium}, {year}
		</p>
		<p class="painting-card__dimensions">
			{dimensions}
		</p>
	</div>
</a>
